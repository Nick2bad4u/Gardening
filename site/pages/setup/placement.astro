---
import SiteLayout from "../../components/SiteLayout.astro";
import DocumentArticle from "../../components/DocumentArticle.astro";
import WateringMap from "../../components/tools/WateringMap.astro";
import { getDocument } from "../../lib/content.mjs";
import { siteUrl } from "../../lib/routes.mjs";
const document = await getDocument("docs/layouts/table-placement-research.md");
const review = await getDocument("docs/two-light-placement-review.md", undefined, "review-");
const diagramSections = document.toc.filter((section) =>
    [
        "illustrated-whole-display",
        "illustrated-front-pots",
        "illustrated-rear-pots-and-windowsill",
        "illustrated-relative-light",
        "whole-display",
        "front-tables-six-columns-four-rows",
        "rear-tables-and-nearby-pots",
    ].includes(section.id)
);
---

<SiteLayout
    title="Current Plant Placement"
    description={document.description}
    section="setup"
    breadcrumbs={[
        { label: "Setup", href: siteUrl("setup/") },
        { label: "Placement", href: "" },
    ]}
>
    <DocumentArticle document={document}>
        <nav class="placement-shortcuts" aria-label="Placement page shortcuts">
            <a class="placement-map-link" href="#watering-map">
                <img src={siteUrl("assets/ui-icons/water.svg")} alt="" width="22" height="22" />
                <span>Jump to watering map</span>
                <span aria-hidden="true">↓</span>
            </a>
            <a href="#placement-diagrams">Placement diagrams ↓</a>
        </nav>
        <WateringMap />
        <nav
            class="diagram-navigation card"
            id="placement-diagrams"
            aria-label="Placement and light diagrams"
        >
            <h2>Placement and Light Diagrams</h2>
            <p>
                Open a diagram to see it at full size. These illustrations show the September 16
                arrangement. Later swaps, newer rear pots, and the Money Tree and terrarium moves
                appear in the <a href="#watering-map">current watering map</a>
                and written placement records. Light shading in the old diagrams is estimated.
            </p>
            <ul>
                {diagramSections.map((section) => (
                    <li>
                        <a href={`#${section.id}`}>{section.title}</a>
                    </li>
                ))}
            </ul>
        </nav>
    </DocumentArticle>
    <section class="placement-review" id="placement-review">
        <h2>Supporting Two-Light Review</h2>
        <p>
            This supporting review retains its dated observations and original context. The
            placement guide above records the latest arrangement.
        </p>
        <details>
            <summary>Read the complete review and sources</summary>
            <div class="prose" set:html={review.html} />
        </details>
    </section>
</SiteLayout>
<style>
    .placement-shortcuts {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-block: -0.5rem 1.5rem;
    }
    .placement-shortcuts a {
        display: inline-flex;
        gap: 0.65rem;
        align-items: center;
        min-block-size: 44px;
        padding: 0.7rem 1rem;
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--ink);
        text-decoration: none;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 12px;
    }
    .placement-shortcuts .placement-map-link {
        color: #ecf4ef;
        background: #18352c;
        border-color: #48705c;
    }
    .placement-shortcuts a:hover,
    .placement-shortcuts a:focus {
        text-decoration: underline;
        border-color: var(--accent);
    }
    .placement-map-link span:last-child {
        margin-inline-start: 0.5rem;
        color: #9ed4b7;
    }
    .diagram-navigation {
        margin-block: 2rem;
    }
    .diagram-navigation ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.5rem;
        padding-inline-start: 1.25rem;
        margin-block-start: 1rem;
    }
    .placement-review {
        margin-block: 3rem;
    }
    summary {
        cursor: pointer;
        padding: 1rem;
        font-weight: 700;
    }
    @media print {
        .placement-shortcuts {
            display: none;
        }
    }
</style>
