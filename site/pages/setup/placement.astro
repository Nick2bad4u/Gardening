---
import SiteLayout from "../../components/SiteLayout.astro";
import DocumentArticle from "../../components/DocumentArticle.astro";
import { getDocument } from "../../lib/content.mjs";
import { siteUrl } from "../../lib/routes.mjs";
const document = await getDocument("docs/layouts/table-placement-research.md");
const review = await getDocument("docs/two-light-placement-review.md", undefined, "review-");
const diagramSections = document.toc.filter((section) =>
    [
        "illustrated-whole-display",
        "illustrated-front-pots",
        "illustrated-rear-pots-and-windowsill",
        "illustrated-relative-light",
        "whole-display",
        "front-tables-six-columns-four-rows",
        "rear-tables-and-north-windowsill",
    ].includes(section.id)
);
---

<SiteLayout
    title="Current Plant Placement"
    description={document.description}
    section="setup"
    breadcrumbs={[
        { label: "Setup", href: siteUrl("setup/") },
        { label: "Placement", href: "" },
    ]}
>
    <DocumentArticle document={document}>
        <nav class="diagram-navigation card" aria-label="Placement and light diagrams">
            <h2>Placement and Light Diagrams</h2>
            <p>
                Open a diagram to see it at full size. These illustrations show the September 16
                arrangement, with Money Tree on the separate north windowsill. Serpent and
                Hook-spined cactus have since exchanged positions; see the{" "}
                <a href="#owner-light-readings-and-confirmed-swap">
                    current positions and light readings
                </a>
                below. Light shading in the diagrams is estimated.
            </p>
            <ul>
                {diagramSections.map((section) => (
                    <li>
                        <a href={`#${section.id}`}>{section.title}</a>
                    </li>
                ))}
            </ul>
        </nav>
    </DocumentArticle>
    <section class="placement-review" id="placement-review">
        <h2>Supporting Two-Light Review</h2>
        <p>
            This supporting review retains its dated observations and original context. The
            placement guide above records the latest arrangement.
        </p>
        <details>
            <summary>Read the complete review and sources</summary>
            <div class="prose" set:html={review.html} />
        </details>
    </section>
</SiteLayout>
<style>
    .diagram-navigation {
        margin-block: 2rem;
    }
    .diagram-navigation ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.5rem;
        padding-inline-start: 1.25rem;
        margin-block-start: 1rem;
    }
    .placement-review {
        margin-block: 3rem;
    }
    summary {
        cursor: pointer;
        padding: 1rem;
        font-weight: 700;
    }
</style>
