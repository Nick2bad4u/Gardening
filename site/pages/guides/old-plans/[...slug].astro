---
import SiteLayout from "../../../components/SiteLayout.astro";
import DocumentArticle from "../../../components/DocumentArticle.astro";
import { getOldPlans } from "../../../lib/content.mjs";
import { siteUrl } from "../../../lib/routes.mjs";
import { archivedAmazonPlan } from "../../../lib/old-plans.mjs";
export async function getStaticPaths() {
    return (await getOldPlans()).map((document) => ({
        params: { slug: document.slug },
        props: { document },
    }));
}
interface Props {
    document: Awaited<ReturnType<typeof import("../../../lib/content.mjs").getDocument>>;
}
const { document } = Astro.props;
const portrait = archivedAmazonPlan.profiles.find(([slug]) => document.slug.endsWith(`/${slug}`));
const portraits = portrait
    ? [{ slug: portrait[0], title: portrait[1] }]
    : [
          { slug: "four-succulent-planter", title: "Former four-succulent planter concept" },
          { slug: "tradescantia-nanouk", title: "Former separate Nanouk concept" },
      ];
---

<SiteLayout
    title={document.title}
    description={document.description}
    section="guides"
    breadcrumbs={[
        { label: "Guides", href: siteUrl("guides/") },
        { label: "Old plans", href: siteUrl("guides/old-plans/") },
        { label: document.title, href: "" },
    ]}
>
    <DocumentArticle document={document}>
        <div class="document-metadata">
            {portraits.map((item) => (
                <figure>
                    <img
                        src={siteUrl(`assets/plant-icons/${item.slug}.svg`)}
                        alt={item.title}
                        width="128"
                        height="128"
                    />
                    <figcaption>
                        {item.title} · Archived schematic artwork, not an owned-plant photograph.
                    </figcaption>
                </figure>
            ))}
        </div>
    </DocumentArticle>
</SiteLayout>
