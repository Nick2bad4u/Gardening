---
import SiteLayout from "../../components/SiteLayout.astro";
import { getGuides } from "../../lib/content.mjs";
import { contentUrl, siteUrl } from "../../lib/routes.mjs";
import { documentAppearance } from "../../lib/document-presentation.mjs";
import "../../styles/documents.css";
const guides = await getGuides();
---

<SiteLayout
    title="Care Guides"
    description="How this collection uses observations, weights, watering records, and permanent labels."
    section="guides"
>
    <div class="guide-library">
        <header class="page-heading guide-library-heading">
            <div class="document-emblem" aria-hidden="true">
                <img
                    src={siteUrl("assets/ui-icons/field-guide.svg")}
                    alt=""
                    width="64"
                    height="64"
                />
            </div>
            <div>
                <p class="eyebrow">The Collection Notebook · {guides.length} Guides</p>
                <h1>Care Guides</h1>
                <p class="lede">
                    Practical watering, weighing, and plant-care guidance for this collection.
                </p>
            </div>
        </header>
        <div class="guide-library-grid">
            {guides.map((guide) => {
                const appearance = documentAppearance(guide.sourcePath);
                const sections = guide.toc.filter((section) => section.level === 2);
                const url = contentUrl(guide.sourcePath);
                return (
                    <article class="guide-library-card" data-tone={appearance.tone}>
                        <header>
                            <img
                                src={siteUrl(`assets/ui-icons/${appearance.icon}.svg`)}
                                alt=""
                                width="48"
                                height="48"
                            />
                            <div>
                                <p class="eyebrow">{appearance.label}</p>
                                <h2>
                                    <a href={url}>{guide.title}</a>
                                </h2>
                            </div>
                        </header>
                        <p>{guide.description}</p>
                        <ul aria-label={`Topics in ${guide.title}`}>
                            {sections.slice(0, 3).map((section) => (
                                <li>
                                    <a href={`${url}#${section.id}`}>{section.title}</a>
                                </li>
                            ))}
                        </ul>
                        <footer>
                            <span>{sections.length} Reference Sections</span>
                            <a href={url}>Read the Guide →</a>
                        </footer>
                    </article>
                );
            })}
        </div>
        <section class="guide-library-card" data-tone="record" aria-labelledby="old-plans-heading">
            <header>
                <img src={siteUrl("assets/ui-icons/history.svg")} alt="" width="48" height="48" />
                <div>
                    <p class="eyebrow">Archived research</p>
                    <h2 id="old-plans-heading">
                        <a href={siteUrl("guides/old-plans/")}>Old plans</a>
                    </h2>
                </div>
            </header>
            <p>
                Previous ideas and abandoned orders, with their plant research preserved separately
                from the active collection.
            </p>
            <footer>
                <a href={siteUrl("guides/old-plans/")}>Browse old plans →</a>
            </footer>
        </section>
    </div>
</SiteLayout>
