---
import { readdir } from "node:fs/promises";
import RetiredReports from "../../components/RetiredReports.astro";

export async function getStaticPaths() {
    const filenames = await readdir("docs/archive/daily-reports");
    return filenames
        .filter((filename) => /^\d{4}-\d{2}-\d{2}\.json$/v.test(filename))
        .map((filename) => ({
            params: { date: filename.slice(0, -5) },
            props: { date: filename.slice(0, -5) },
        }));
}
const { date } = Astro.props;
---

<RetiredReports date={date} />
