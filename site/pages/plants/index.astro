---
import SiteLayout from "../../components/SiteLayout.astro";
import PlantCard from "../../components/PlantCard.astro";
import { getProfiles } from "../../lib/content.mjs";
import { getContainers } from "../../lib/containers.mjs";
import { siteUrl } from "../../lib/routes.mjs";
import { groups } from "../../lib/content/profile-source.mjs";
const profiles = await getProfiles();
const containers = await getContainers();
const containersById = new Map(containers.map((container) => [container.id, container]));
const overviewSlugs = new Set(
    containers.flatMap((container) => (container.overview ? [container.overview.slug] : []))
);
const currentCount = profiles.filter(
    (profile) => !profile.historical && !overviewSlugs.has(profile.slug)
).length;
---

<SiteLayout
    title="Plants"
    section="plants"
    description="Browse the Fenton Collection by plant name, scientific name, label, and pot ID."
>
    <header class="page-heading directory-heading">
        <p class="eyebrow">THE FENTON COLLECTION</p>
        <h1>Meet the plants.</h1>
        <p class="lede">Names, care notes, photos, and nursery records for the collection.</p>
        <a class="button button-secondary" href={siteUrl("containers/")}>
            Explore {containers.length} containers &amp; shared planters →
        </a>
    </header>
    <div class="directory-toolbar no-print">
        <label for="plant-search">
            Find a plant
            <input
                type="search"
                id="plant-search"
                placeholder="Name, scientific name, label, or P-ID"
                autocomplete="off"
            />
        </label>
        <label for="plant-group">
            Collection
            <select id="plant-group">
                <option value="all">All collections</option>
                {groups.map((group) => (
                    <option value={group.key}>{group.title}</option>
                ))}
            </select>
        </label>
        <label for="plant-status">
            Records
            <select id="plant-status">
                <option value="current">Current botanical profiles</option>
                <option value="overviews">Planter overviews</option>
                <option value="all">All records</option>
                <option value="historical">Historical only</option>
            </select>
        </label>
    </div>
    <p id="plant-result-count" class="result-count" role="status" aria-live="polite">
        {currentCount} active botanical profiles · {overviewSlugs.size} separate planter overviews ·{" "}
        {containers.length} containers
    </p>
    <noscript>
        <p>
            Search and filters need JavaScript. Current profiles are listed below; historical
            records are also available through site search and the repository.
        </p>
    </noscript>
    <ul class="card-grid plant-directory" id="plant-directory" aria-label="Plant directory">
        {profiles.map((profile) => (
            <li
                data-directory-entry
                data-search={profile.searchText}
                data-group={profile.group}
                data-historical={String(profile.historical)}
                data-overview={String(overviewSlugs.has(profile.slug))}
                hidden={profile.historical || overviewSlugs.has(profile.slug)}
            >
                <PlantCard
                    profile={profile}
                    overview={overviewSlugs.has(profile.slug)}
                    sharedProfileCount={
                        profile.trackerId
                            ? (containersById.get(profile.trackerId)?.members.length ?? 1)
                            : 1
                    }
                />
            </li>
        ))}
    </ul>
    <p id="plant-empty" class="empty-state" hidden>
        No matching plants. Try a different name, label, or collection.
    </p>
</SiteLayout>
<script src="../../client/directory.js"></script>
<style>
    .directory-heading {
        margin-block-end: 1.25rem;
        & .eyebrow {
            margin-block-end: 0.45rem;
        }
        & h1 {
            margin-block-end: 0.5rem;
            font-size: clamp(2rem, 4vi, 3rem);
        }
        & .lede {
            margin-block-end: 0;
            line-height: 1.5;
        }
    }
    .directory-toolbar {
        gap: 0.75rem;
        padding: 0.875rem;
        margin-block-end: 0.75rem;
    }
    .plant-directory {
        grid-auto-rows: auto;
        gap: 1rem;
    }

    @media (width <= 600px) {
        .directory-toolbar {
            display: grid;
            grid-template-columns:
                [start] repeat(2, [column-start] minmax(0, 1fr) [column-end])
                [end];
            & label {
                min-inline-size: 0;
            }
            & label:first-child {
                grid-column: start / end;
            }
            & select {
                inline-size: 100%;
                min-inline-size: 0;
            }
        }
    }
</style>
