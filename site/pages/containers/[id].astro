---
import SiteIcon from "../../components/SiteIcon.astro";
import SiteLayout from "../../components/SiteLayout.astro";
import ContainerMembers from "../../components/ContainerMembers.astro";
import { getContainers } from "../../lib/containers.mjs";
import { getDocument, renderMarkdown } from "../../lib/content.mjs";
import { loggerUrl, potUrl, siteUrl } from "../../lib/routes.mjs";
export async function getStaticPaths() {
    return (await getContainers()).map((container) => ({
        params: { id: container.id },
        props: { container },
    }));
}
interface Props {
    container: import("../../lib/containers.mjs").Container;
}
const { container } = Astro.props;
const arrivalRecord = container.id === "P38" ? await getDocument("docs/terrarium.md") : undefined;
const primaryProfile = container.overview ?? container.members[0];
const currentPot =
    !container.shared && primaryProfile && container.currentPot
        ? await renderMarkdown(container.currentPot, primaryProfile.sourcePath)
        : undefined;
---

<SiteLayout
    title={`${container.id} · ${container.name}`}
    section="containers"
    description={`Container ${container.id}, label ${container.label}: setup, botanical members, and shared care history.`}
    breadcrumbs={[{ label: "Containers", href: siteUrl("containers/") }]}
>
    <header class="page-heading">
        <p class="eyebrow">
            {container.shared ? "Shared planter" : "Container"} · {container.id} · {container.label}
        </p>
        <h1>{container.name}</h1>
        <p class="lede">
            {container.pending || container.aggregate
                ? "One terrarium history, with arrival photographs and provisional plant identifications."
                : container.shared
                  ? "Meet the plants growing together and follow their shared care history."
                  : "The pot, growing mix, and care history for this plant."}
        </p>
        <div class="action-row">
            {arrivalRecord && (
                <a class="button button-secondary" href="#arrival-photographs">
                    <SiteIcon name="photos" /> Arrival photographs
                </a>
            )}
            <a class="button" href={potUrl(container.id)}>
                <SiteIcon name="history" /> Open {container.id} history →
            </a>
            <a class="button button-secondary" href={loggerUrl}>
                <SiteIcon name="edit" /> Log care
            </a>
            {container.sheetUrl && (
                <a class="button button-secondary" href={container.sheetUrl}>
                    <SiteIcon name="sheets" /> Google Sheets ↗
                </a>
            )}
        </div>
    </header>
    <ContainerMembers container={container} showContainerLink={false} />
    <section class="card">
        <h2 class="icon-heading">
            <SiteIcon name="repot" size={32} /> Recorded container setup
        </h2>
        {currentPot && <div class="prose" set:html={currentPot.html} />}
        <p>{container.setupNote}</p>
        <p>
            The care history includes dated repotting and drainage changes, alongside watering and
            weight records.
        </p>
    </section>
    {arrivalRecord && (
        <section class="card prose terrarium-arrival" aria-label="Terrarium arrival record">
            <div set:html={arrivalRecord.html} />
        </section>
    )}
</SiteLayout>
<style>
    .terrarium-arrival :global(.placement-figure) {
        max-inline-size: 28rem;
    }
</style>
