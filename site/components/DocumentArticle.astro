---
import { repositoryUrl } from "../lib/routes.mjs";
interface Props {
    document: Awaited<ReturnType<typeof import("../lib/content.mjs").getDocument>>;
}
const { document } = Astro.props;
---

<article class="document-article">
    <header class="page-heading">
        <h1>{document.title}</h1>
        <a class="source-link" href={`${repositoryUrl}/blob/main/${document.sourcePath}`}>
            Maintained Source ↗
        </a>
    </header>
    <slot />
    <div class="article-layout">
        <aside class="article-toc" aria-label="On this page">
            <h2>On this page</h2>
            <ul>
                {document.toc
                    .filter((item) => item.level === 2)
                    .map((item) => (
                        <li>
                            <a href={`#${item.id}`}>{item.title}</a>
                        </li>
                    ))}
            </ul>
        </aside>
        <div class="prose" set:html={document.html} />
    </div>
</article>
<style>
    .document-article > .article-layout > .prose {
        padding: clamp(1rem, 2.5vi, 2rem);
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
    }
    .source-link {
        font-size: 0.85rem;
    }
    @media print {
        .document-article > .article-layout > .prose {
            padding: 0;
            border: 0;
        }
        .source-link {
            display: none;
        }
    }
</style>
