---
import { repositoryUrl, siteUrl } from "../lib/routes.mjs";
import { documentSections } from "../lib/document-presentation.mjs";
import "../styles/documents.css";
interface Props {
    document: Awaited<ReturnType<typeof import("../lib/content.mjs").getDocument>>;
}
const { document } = Astro.props;
const { appearance, introduction, sections } = documentSections(document);
---

<article class="document-article" data-tone={appearance.tone}>
    <header class="page-heading document-heading">
        <div class="document-emblem" aria-hidden="true">
            <img
                src={siteUrl(`assets/ui-icons/${appearance.icon}.svg`)}
                alt=""
                width="64"
                height="64"
            />
        </div>
        <div>
            <p class="eyebrow">{appearance.label}</p>
            <h1>{document.title}</h1>
            <div class="document-metadata">
                <span>{sections.length} Reference Sections</span>
                <a
                    class="source-link"
                    href={`${repositoryUrl}/blob/main/${document.sourcePath}`}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <img
                        src={siteUrl("assets/ui-icons/source.svg")}
                        alt=""
                        width="18"
                        height="18"
                    />
                    View on GitHub ↗
                </a>
            </div>
        </div>
    </header>
    <slot />
    <div class="article-layout">
        <aside class="article-toc" aria-label="On this page">
            <details class="document-contents" data-document-contents>
                <summary>
                    On This Page <span>{sections.length} Sections</span>
                </summary>
                <ul>
                    {sections.map((item) => (
                        <li>
                            <a href={`#${item.id}`}>
                                <span class="toc-number" aria-hidden="true">
                                    {item.number}
                                </span>
                                <span>{item.title}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </details>
        </aside>
        <div class="prose document-body">
            {introduction.trim() && <div class="document-introduction" set:html={introduction} />}
            {sections.map((section) => (
                <section
                    class="document-section"
                    data-tone={section.tone}
                    aria-labelledby={section.id}
                >
                    <div class="document-section-marker" aria-hidden="true">
                        <img
                            src={siteUrl(`assets/ui-icons/${section.icon}.svg`)}
                            alt=""
                            width="30"
                            height="30"
                        />
                        <span>
                            {section.number} · {section.label}
                        </span>
                    </div>
                    <div class="document-section-content" set:html={section.html} />
                </section>
            ))}
        </div>
    </div>
</article>
<script>
    const desktop = window.matchMedia("(min-width: 901px)");
    const contents = document.querySelector<HTMLDetailsElement>("[data-document-contents]");
    if (contents) {
        contents.open = desktop.matches;
        desktop.addEventListener("change", (event) => {
            contents.open = event.matches;
        });
    }
</script>
