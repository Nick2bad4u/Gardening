<section class="section tab-panel" id="wiring" role="tabpanel" aria-labelledby="tab-wiring" hidden>
    <div class="section-heading">
        <div>
            <p class="eyebrow">Diagram 4</p>
            <h2>Wiring and drip loop</h2>
        </div>
        <p>
            A cable should dip below its connection before rising to the outlet or controller. Water
            reaches the low point and falls away from the electrical connection.
        </p>
    </div>

    <div class="diagram-shell">
        <div class="diagram-header">
            <strong>Right-wall cable path</strong>
            <span>Connection high · loop low · electrical equipment off the floor</span>
        </div>
        <div class="room-grid">
            <svg
                class="diagram"
                viewBox="0 0 760 520"
                role="img"
                aria-labelledby="drip-title drip-desc"
            >
                <title id="drip-title">
                                Safe cable drip loop beside the grow tables
                            </title>
                <desc id="drip-desc">
                    The camera and controller cable descends below a wall outlet, curves through a
                    low point where water can drip off, and then rises into the protected electrical
                    connection. Trays and the watering area remain below and away from the outlet.
                </desc>

                <line x1="605" y1="45" x2="605" y2="465" class="wall"></line>
                <rect x="548" y="89" width="57" height="78" rx="7" class="safe-zone"></rect>
                <rect x="560" y="105" width="33" height="48" rx="4" class="camera"></rect>
                <circle cx="569" cy="128" r="5" class="camera"></circle>
                <text x="532" y="112" class="svg-label" text-anchor="end">
                    WALL CAMERA
                </text>

                <rect x="558" y="206" width="47" height="55" rx="5" class="safe-zone"></rect>
                <circle cx="570" cy="222" r="4" class="pot"></circle>
                <circle cx="591" cy="222" r="4" class="pot"></circle>
                <text x="540" y="224" class="svg-label" text-anchor="end">
                    OUTLET / ADAPTER
                </text>
                <text x="540" y="244" class="svg-small" text-anchor="end">
                    ABOVE WATERING ZONE
                </text>

                <path
                    d="M575 153C575 191 527 217 527 298C527 371 581 390 581 259"
                    class="cable"
                ></path>
                <text x="438" y="322" class="svg-label" text-anchor="middle">
                    LOW POINT
                </text>
                <text x="438" y="343" class="svg-small" text-anchor="middle">
                    WATER FALLS AWAY HERE
                </text>
                <line x1="476" y1="345" x2="546" y2="380" class="measure"></line>
                <path
                    d="M533 388C525 401 520 411 520 424C520 436 529 444 539 444C550 444 558 436 558 424C558 411 550 401 542 388Z"
                    class="water-drop"
                ></path>

                <rect x="112" y="365" width="306" height="35" rx="7" class="glass"></rect>
                <path d="M146 365L153 337H205L212 365Z" class="older-planter"></path>
                <path d="M276 365L283 337H335L342 365Z" class="succulent-planter"></path>
                <rect x="88" y="400" width="360" height="48" rx="8" class="floor-mylar"></rect>
                <text x="265" y="388" class="svg-small" text-anchor="middle">
                    ROUND TABLE / WATERING ZONE
                </text>
                <text x="268" y="431" class="svg-small" text-anchor="middle">
                    FLOOR MYLAR BELOW
                </text>

                <line x1="70" y1="468" x2="650" y2="468" class="target"></line>
                <text x="73" y="495" class="svg-small">
                    FLOOR — NO POWER STRIP OR CONNECTOR HERE
                </text>
            </svg>

            <aside class="key">
                <h3>Use this on every hanging cable</h3>
                <dl class="key-list">
                    <div class="key-item">
                        <dt>Make one low bend</dt>
                        <dd>
                            Route the cable below the outlet, adapter, E25, or camera connection
                            before it rises into that connection.
                        </dd>
                    </div>
                    <div class="key-item">
                        <dt>Clip the upper run</dt>
                        <dd>
                            Secure the cable to the right wall so the loop cannot swing into plants,
                            the fans, or the aisle.
                        </dd>
                    </div>
                    <div class="key-item">
                        <dt>Keep the low point clear</dt>
                        <dd>
                            The bend belongs outside trays and watering paths. It should not rest on
                            the floor Mylar or carpet.
                        </dd>
                    </div>
                </dl>
            </aside>
        </div>
    </div>
</section>
