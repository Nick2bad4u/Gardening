                    data-status="High-confidence ID · hooked central spine catches skin and fabric"
                    data-profile={siteUrl("plants/mammillaria-rekoi/")}
                    tabindex="0"
                    role="img"
                    aria-label="F1, Cactus-06 hook-spined pincushion cactus"
                >
                    <title>
                                    F1 — Cactus-06 — Hook-spined pincushion
                                </title>
                    <circle cx="465" cy="260" r="45" class="pot"></circle>
                    <text x="465" y="266" class="pot-id" text-anchor="middle">
                        F1
                    </text>
                </g>
                <g
                    data-plant-marker
