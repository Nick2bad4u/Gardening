                    tabindex="0"
                    role="img"
                    aria-label="F3, Cactus-04 yellow tower cactus"
                >
                    <title>
                                    F3 — Cactus-04 — Yellow tower cactus
                                </title>
                    <circle cx="155" cy="260" r="45" class="pot"></circle>
                    <text x="155" y="266" class="pot-id" text-anchor="middle">
                        F3
                    </text>
                </g>
                <g
                    data-plant-marker
                    data-detail-target="wood-new"
                    data-name="Boobie cactus"
                    data-botanical="Myrtillocactus geometrizans 'Fukurokuryuzinboku'"
