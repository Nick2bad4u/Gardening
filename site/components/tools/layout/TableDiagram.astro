                    <circle cx="310" cy="260" r="38" class="pot"></circle>
                    <text x="310" y="266" class="pot-id" text-anchor="middle">
                        F2
                    </text>
                </g>
                <g
                    data-plant-marker
                    data-detail-target="wood-new"
                    data-name="Hook-spined pincushion cactus"
                    data-botanical="Probable Mammillaria cf. rekoi"
