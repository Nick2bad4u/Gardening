---
import { containerUrl, profileUrl, siteUrl } from "../../../lib/routes.mjs";
import { stripMarkdown } from "../../../lib/content/profile-source.mjs";
interface Props {
    potId?: string;
    profiles?: readonly import("../../../lib/content.mjs").SiteProfile[];
}
const { potId = "", profiles = [] } = Astro.props;
const primaryProfile = profiles[0];
const potLabel = primaryProfile?.drawerLabel.primary;
const initialName =
    profiles.length > 1
        ? `Shared container ${potLabel ?? potId}`
        : (primaryProfile?.title ?? (potId ? `Pot ${potId}` : "Plant history"));
---

<header class="hero history-hero">
    <span hidden>
        <svg
            data-tool-icon-template
            class="site-icon"
            viewBox="0 0 64 64"
            aria-hidden="true"
            focusable="false"
        >
            <use href={siteUrl("plant-icons.svg#icon-cactus")} width="64" height="64"></use>
        </svg>
    </span>
    <div>
        <p class="eyebrow" id="plant-label">
            {potLabel ? `${potLabel} · ${potId}` : potId || "Collection observations"}
        </p>
        <h1 id="plant-name">{initialName}</h1>
        <div class="scientific-heading" id="plant-scientific">
            {profiles.map((profile) => stripMarkdown(profile.scientificMarkdown)).join(" · ")}
        </div>
        <p class="lede">
            Follow watering, growth, and observations over time. Compare pot weights within the same
            setup to see how the mix dries between waterings.
        </p>
    </div>
    <div class="hero-actions">
        <div
            class="profile-actions"
            id="profile-actions"
            role="group"
            aria-label="Field guide profiles"
        >
            {profiles.map((profile) => (
                <a class="button" href={profileUrl(profile.slug)}>
                    <img
                        src={siteUrl(`assets/plant-icons/${profile.slug}.svg`)}
                        width="28"
                        height="28"
                        alt=""
                    />
                    {profile.title}
                </a>
            ))}
        </div>
        {potId && (
            <a class="button" href={containerUrl(potId)}>
                Container setup &amp; members →
            </a>
        )}
        <a
            class="button primary"
            id="edit-history"
            href="https://docs.google.com/spreadsheets/d/1XatdY2Z7izqHtE1ZVfCyu3yWkFviKllhqVQT2Z_88M0/edit?gid=2015971861#gid=2015971861"
            target="_blank"
            rel="noreferrer"
        >
            <svg class="site-icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                <use href={siteUrl("plant-icons.svg#icon-edit")} width="64" height="64"></use>
            </svg>
            Open Quick log
        </a>
        <a
            class="button"
            href="https://script.google.com/macros/s/AKfycbytpdMto4ZAqOf49igDNoGYr-J6fmSRDNJOKP4-dKDFRmM2YkTCKJp3kmhrD4gOJShF/exec"
            target="_blank"
            rel="noreferrer"
        >
            <svg class="site-icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                <use href={siteUrl("plant-icons.svg#icon-mobile")} width="64" height="64"></use>
            </svg>
            Open mobile logger
        </a>
        <a
            class="button"
            id="sheet-plant-page"
            href="https://docs.google.com/spreadsheets/d/1XatdY2Z7izqHtE1ZVfCyu3yWkFviKllhqVQT2Z_88M0/edit?gid=1875598047#gid=1875598047"
            target="_blank"
            rel="noreferrer"
        >
            <svg class="site-icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                <use href={siteUrl("plant-icons.svg#icon-sheets")} width="64" height="64"></use>
            </svg>
            Open Sheets plant page
        </a>
        <a class="button" href={siteUrl("tracker/")}>
            <svg class="site-icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                <use href={siteUrl("plant-icons.svg#icon-arrow-left")} width="64" height="64"></use>
            </svg>
            Back to all plants
        </a>
    </div>
</header>
