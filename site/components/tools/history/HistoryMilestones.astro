<section class="analytics-panel" aria-labelledby="care-title">
    <header>
        <div>
            <p class="eyebrow">Structured care history</p>
            <h2 id="care-title">Care milestones</h2>
            <p>
                Counts come from dated Water, Repot, Flower, Photo, Pest, Check, and Rotation
                events. A zero means nothing has been logged yet.
            </p>
        </div>
    </header>
    <div class="trend-grid care-milestones">
        <article>
            <span>Current pot size</span>
            <strong id="current-pot-size">—</strong>
            <small id="latest-repot-detail">No repot logged</small>
        </article>
        <article>
            <span>Nutrient waterings</span>
            <strong id="nutrient-count">0</strong>
            <small id="latest-nutrient-detail">No fertilizer logged</small>
        </article>
        <article>
            <span>Flower events</span>
            <strong id="flower-count">0</strong>
            <small id="latest-flower-detail">No flowers logged</small>
        </article>
        <article>
            <span>Photo links</span>
            <strong id="photo-count">0</strong>
            <small id="latest-photo-detail">No photos logged</small>
        </article>
        <article>
            <span>Pest / issue events</span>
            <strong id="pest-count">0</strong>
            <small id="latest-pest-detail">No issues logged</small>
        </article>
        <article>
            <span>Plant checks</span>
            <strong id="check-count">0</strong>
            <small id="latest-check-detail">No checks logged</small>
        </article>
        <article>
            <span>Rotations</span>
            <strong id="rotation-count">0</strong>
            <small id="latest-rotation-detail">No rotation logged</small>
        </article>
        <article>
            <span>Clean events</span>
            <strong id="clean-count">0</strong>
            <small id="latest-clean-detail">No cleaning logged</small>
        </article>
        <article>
            <span>Prune events</span>
            <strong id="prune-count">0</strong>
            <small id="latest-prune-detail">No pruning logged</small>
        </article>
    </div>
</section>
