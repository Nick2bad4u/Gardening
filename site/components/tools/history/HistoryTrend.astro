<section class="analytics-panel" aria-labelledby="trend-title">
    <header>
        <div>
            <p class="eyebrow">Calculated from the log</p>
            <h2 id="trend-title">Trend snapshot</h2>
            <p>
                Height and width trends use only measured readings. Corrected readings count only
                when their measurement method is Ruler. Estimates, blank-quality readings, and
                Removed records stay in observation history but do not affect growth analytics.
            </p>
        </div>
    </header>
    <div class="trend-grid">
        <article>
            <span>Weight change</span>
            <strong id="weight-change">—</strong>
            <small id="weight-change-detail">Needs 2 weights</small>
        </article>
        <article>
            <span>3-reading weight mean</span>
            <strong id="weight-moving-average">—</strong>
            <small id="weight-average-detail">Active pot setup only</small>
        </article>
        <article>
            <span>Dry-weight spread</span>
            <strong id="dry-spread">—</strong>
            <small id="dry-spread-detail">Needs 2 dry weights</small>
        </article>
        <article>
            <span>Wet-weight spread</span>
            <strong id="wet-spread">—</strong>
            <small id="wet-spread-detail">Needs 2 wet weights</small>
        </article>
        <article>
            <span>Height trend</span>
            <strong id="height-trend">—</strong>
            <small id="height-trend-detail">Needs 2 measured readings.</small>
        </article>
        <article>
            <span>Width trend</span>
            <strong id="width-trend">—</strong>
            <small id="width-trend-detail">Needs 2 measured readings.</small>
        </article>
        <article>
            <span>Watering interval</span>
            <strong id="watering-average">—</strong>
            <small id="watering-detail">Needs 2 water events</small>
        </article>
        <article>
            <span>Observation coverage</span>
            <strong id="observation-span">—</strong>
            <small id="observation-span-detail">No dated history</small>
        </article>
    </div>
</section>
