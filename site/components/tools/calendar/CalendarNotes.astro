---
import { siteUrl } from "../../../lib/routes.mjs";
---

<section class="section" aria-labelledby="next-title">
    <div class="section-heading">
        <div>
            <h2 id="next-title">
                <svg class="site-icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                    <use href={siteUrl("plant-icons.svg#icon-growth")} width="64" height="64"></use>
                </svg>
                After the fixed ramp
            </h2>
            <p>Keep power and fan strength steady; change only the timer.</p>
        </div>
    </div>
    <div class="after-ramp">
        <article class="next-card">
            <strong>September 21</strong>
            <span>Light 7:15 a.m.–7:30 p.m. · fan 7:45 a.m.–7:15 p.m.</span>
        </article>
        <article class="next-card">
            <strong>October 1</strong>
            <span>Light 7:30 a.m.–7:15 p.m. · fan 7:45 a.m.–7:00 p.m.</span>
        </article>
        <article class="next-card">
            <strong>October 19</strong>
            <span>Light 8:00 a.m.–6:45 p.m. · fan 8:15 a.m.–6:30 p.m.</span>
        </article>
    </div>
</section>
