---
import {
    loggerUrl,
    primaryNavigation,
    repositoryUrl,
    siteBase,
    siteOrigin,
    siteUrl,
} from "../lib/routes.mjs";
import { siteAppForPath } from "../lib/site-apps.mjs";
import SiteIcon from "./SiteIcon.astro";
import "../styles/tokens.css";
import "../styles/site.css";
import "../styles/content.css";
interface Props {
    title: string;
    description?: string;
    section?: string;
    breadcrumbs?: { label: string; href: string }[];
    class?: string;
    noindex?: boolean;
}
const {
    title,
    description = "A growing collection of plants, observations, and practical care notes. The Fenton Collection.",
    section = "",
    breadcrumbs = [],
    class: className = "",
    noindex = false,
} = Astro.props;
const app = siteAppForPath(Astro.url.pathname);
const isReportApp = app?.route === "report/" || app?.route === "pocket-report/";
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
---

<!doctype html>
<html lang="en" data-site-base={siteBase}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="theme-color" content={app?.themeColor ?? "#244633"} />
        {noindex && <meta name="robots" content="noindex" />}
        <title>{(isReportApp ? title : undefined) ?? (title === "The Garden" ? "The Garden · Fenton Collection" : `${title} · The Garden`)}</title>
        <link rel="canonical" href={canonical} />
        <link
            rel="icon"
            type="image/svg+xml"
            href={siteUrl(`assets/ui-icons/${app?.icon ?? "cactus"}.svg`)}
        />
        {app && (
            <>
                <meta name="application-name" content={app.name} />
                <meta name="apple-mobile-web-app-title" content={app.name} />
                <link rel="manifest" href={siteUrl(`${app.route}manifest.webmanifest`)} />
                <link
                    rel="icon"
                    type="image/png"
                    sizes="192x192"
                    href={siteUrl(`assets/report-apps/${app.icon}-192.png`)}
                />
                <link
                    rel="apple-touch-icon"
                    sizes="192x192"
                    href={siteUrl(`assets/report-apps/${app.icon}-192.png`)}
                />
            </>
        )}
        <script is:inline>
            try {
                const savedTheme = localStorage.getItem("gardening-site-theme");
                document.documentElement.dataset["theme"] =
                    savedTheme === "light" || savedTheme === "dark"
                        ? savedTheme
                        : matchMedia("(prefers-color-scheme: dark)").matches
                          ? "dark"
                          : "light";
            } catch {
                document.documentElement.dataset["theme"] = "light";
            }
        </script>
        <slot name="head" />
    </head>
    <body class:list={[className, `section-${section || "home"}`]}>
        <a href="#main" class="skip-link">
            Skip to content
        </a>
        <header class="site-header">
            <div class="header-inner">
                <a class="site-brand" href={siteUrl()} aria-label="The Garden home">
                    <SiteIcon name="houseplant" size={44} />
                    <span>
                        <strong>The Garden</strong>
                        <small>FENTON COLLECTION</small>
                    </span>
                </a>
                <button
                    class="menu-toggle icon-button"
                    aria-expanded="false"
                    aria-controls="site-nav"
                    type="button"
                    data-menu-toggle
                    aria-label="Menu"
                >
                    <SiteIcon name="menu" />
                    <span>Menu</span>
                </button>
                <nav id="site-nav" class="site-nav" aria-label="Main navigation">
                    {primaryNavigation.map((item) => (
                        <a
                            href={item.href}
                            aria-current={section === item.section ? "page" : undefined}
                        >
                            <SiteIcon name={item.icon} size={22} />
                            <span>{item.label}</span>
                        </a>
                    ))}
                </nav>
                <div class="header-actions">
                    <a href={siteUrl("search/")} class="icon-button" aria-label="Search the garden">
                        <SiteIcon name="search" />
                        <span class="visually-hidden">Search</span>
                    </a>
                    <button
                        id="theme-toggle"
                        type="button"
                        class="icon-button"
                        aria-label="Toggle color theme"
                        title="Change color theme"
                    >
                        <SiteIcon name="theme" />
                        <span id="theme-label" class="visually-hidden">
                            Theme
                        </span>
                    </button>
                    <a
                        class="button button-small log-care"
                        href={loggerUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <SiteIcon name="edit" size={18} />
                        <span>Log Care</span>
                        <span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                </div>
            </div>
        </header>
        <main id="main" class="site-main" tabindex="-1">
            {breadcrumbs.length > 0 && (
                <nav class="breadcrumbs" aria-label="Breadcrumb">
                    <ol>
                        <li>
                            <a href={siteUrl()}>Home</a>
                        </li>
                        {breadcrumbs
                            .filter((item) => item.href !== "")
                            .map((item) => (
                                <li>
                                    <a href={item.href}>{item.label}</a>
                                </li>
                            ))}
                        <li aria-current="page">{title}</li>
                    </ol>
                </nav>
            )}
            <slot />
        </main>
        <footer id="site-footer" class="site-footer">
            <div class="footer-inner">
                <div>
                    <a class="footer-brand" href={siteUrl()}>
                        <SiteIcon name="houseplant" size={36} />
                        The Garden
                    </a>
                    <p>
                        A personal collection. An ongoing notebook.
                        <br />A little more understood with every observation.
                    </p>
                </div>
                <nav aria-label="Footer navigation">
                    <a href={siteUrl("guides/")}>
                        <SiteIcon name="field-guide" />
                        <span>Care &amp; logging guides</span>
                    </a>
                    <a href={siteUrl("setup/equipment/")}>
                        <SiteIcon name="light" />
                        <span>Equipment &amp; supplies</span>
                    </a>
                    <a href={siteUrl("reports/")}>
                        <SiteIcon name="history" />
                        <span>Report archive</span>
                    </a>
                    <a href={repositoryUrl}>
                        <SiteIcon name="source" />
                        <span>Repository &amp; sources</span>
                    </a>
                    <a href={siteUrl("storybook/")} data-astro-prefetch="false">
                        <SiteIcon name="layout" />
                        <span>Component workbench</span>
                    </a>
                    <a href={`${repositoryUrl}/blob/main/assets/plants/ATTRIBUTION.md`}>
                        <SiteIcon name="camera" />
                        <span>Photo credits</span>
                    </a>
                </nav>
                <p class="footer-note">
                    <a href="#main">
                        <SiteIcon name="arrow-up" /> Back to top
                    </a>
                </p>
            </div>
        </footer>
        <script src="../client/site.js"></script>
    </body>
</html>
