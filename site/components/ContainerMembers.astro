---
import { containerUrl, potUrl, profileUrl, siteUrl } from "../lib/routes.mjs";
import { identificationLabel, stripMarkdown } from "../lib/content/profile-source.mjs";
import SiteIcon from "./SiteIcon.astro";
import "../styles/containers.css";
interface Props {
    container: import("../lib/containers.mjs").Container;
    currentSlug?: string;
    showContainerLink?: boolean;
}
const { container, currentSlug, showContainerLink = true } = Astro.props;
---

<section class="card container-members" aria-label={`${container.id} container and members`}>
    <div class="section-heading">
        <div>
            <p class="eyebrow">
                {container.shared ? "Shared container" : "Container"} · {container.id} ·{" "}
                {container.label}
            </p>
            <h2>
                <SiteIcon name="succulent" size={32} /> {container.name} · {container.id}
            </h2>
            <p>
                {container.members.length} botanical{" "}
                {container.members.length === 1 ? "profile" : "profiles"} · one container history
            </p>
        </div>
        {showContainerLink && (
            <a class="button button-secondary" href={containerUrl(container.id)}>
                Container details →
            </a>
        )}
    </div>
    <ul class="container-member-list">
        {container.members.map((member) => (
            <li>
                <a
                    class="container-member-link"
                    href={profileUrl(member.slug)}
                    aria-current={member.slug === currentSlug ? "page" : undefined}
                >
                    <img
                        src={siteUrl(`assets/plant-icons/${member.slug}.svg`)}
                        alt=""
                        width="64"
                        height="64"
                        loading="lazy"
                    />
                    <span>
                        <strong>{member.title}</strong>
                        <span class="container-member-scientific">
                            {stripMarkdown(member.scientificMarkdown)}
                        </span>
                        <span class="badge">
                            {identificationLabel(member.identificationMarkdown)}
                        </span>
                        {member.slug === currentSlug && <span class="badge">This profile</span>}
                    </span>
                </a>
            </li>
        ))}
    </ul>
    <p>{container.careNote}</p>
    {container.shared && (
        <p class="container-care-note">
            <strong>One care record:</strong> log watering, feeding, weighing, and repotting once
            for {container.id}. Include a plant's name when an observation concerns just that
            member.
        </p>
    )}
    <div class="action-row">
        <a class="button" href={potUrl(container.id)}>
            Open {container.id} care history →
        </a>
        {container.overview && (
            <a class="button button-secondary" href={profileUrl(container.overview.slug)}>
                Planter overview{container.overview.slug === currentSlug ? " · this page" : ""}
            </a>
        )}
    </div>
</section>
