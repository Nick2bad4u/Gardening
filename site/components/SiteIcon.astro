---
import { siteUrl } from "../lib/routes.mjs";
interface Props {
    name: string;
    size?: number;
    class?: string;
}
const { name, size = 22, class: className = "" } = Astro.props;
---

<img
    class:list={["site-icon", className]}
    src={siteUrl(`assets/ui-icons/${name}.svg`)}
    width={size}
    height={size}
    alt=""
    aria-hidden="true"
/>
