---
import { contentUrl, potUrl, profileUrl, repositoryUrl, siteUrl } from "../lib/routes.mjs";
import { getProfiles, photoPreview } from "../lib/content.mjs";
import { stripMarkdown } from "../lib/content/profile-source.mjs";
import SiteIcon from "./SiteIcon.astro";
import ProfileNavigation from "./ProfileNavigation.astro";
import "../styles/profile.css";
import "../styles/profile-details.css";
interface Props {
    profile: import("../lib/content.mjs").SiteProfile;
}
const { profile } = Astro.props;
const profiles = await getProfiles();
const siblings = profiles.filter(
    (item) => item.trackerId && item.trackerId === profile.trackerId && item.slug !== profile.slug
);
const index = profiles.findIndex((item) => item.slug === profile.slug);
const previous = profiles[index - 1];
const next = profiles[index + 1];
const heroPhoto = profile.selectedPhotos[0];
const ownedAvatarId = profile.avatar?.external ? profile.avatar.image_id : undefined;
const ownedAvatar = ownedAvatarId
    ? profile.collectionRecord.photos.find(
          (photo) => photo.kind === "collection" && photo.image_id === ownedAvatarId
      )
    : undefined;
const collectionCaptures = profile.collectionRecord.photos.filter(
    (photo) => photo.kind === "collection"
);
const newestCapture = profile.ownedPhotos[0];
const collectionIcon = {
    cacti: "cactus",
    succulents: "succulent",
    rehab: "rehab",
    houseplants: "houseplant",
}[profile.group];
const photoDate = (value: string | undefined) => {
    if (!value || !/^\d{4}-\d{2}-\d{2}$/v.test(value)) return value ?? "Date not recorded";
    return new Intl.DateTimeFormat("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
        timeZone: "UTC",
    }).format(new Date(`${value}T12:00:00Z`));
};
const sectionIcon = (title: string) => {
    if (/care|water|grow/iv.test(title)) return "care";
    if (/ident|name|label/iv.test(title)) return "identity";
    if (/risk|problem|caution/iv.test(title)) return "caution";
    if (/source|reference|research/iv.test(title)) return "research";
    if (/origin|habitat|range/iv.test(title)) return "habitat";
    if (/history|record/iv.test(title)) return "history";
    return "botanical";
};
const metadata = [
    ["Collection Record", profile.inventoryId, "inventory"],
    ["Permanent Label", profile.labelHtml, "label"],
    ["Identification", profile.identificationHtml, "identity"],
    ["Status", profile.statusHtml, "status"],
    ["Acquired From", profile.acquiredFromHtml, "source"],
    ["Acquired On", profile.acquiredOnHtml, "calendar"],
    ["Ordered From", profile.orderedFromHtml, "seller"],
].filter(([, value]) => value);
---

<article
    class="plant-profile"
    data-plant-profile={profile.slug}
    data-collection={profile.group}
    style={`--plant-cursor: url("${siteUrl("cactus-cursor.svg")}") 1 1, auto`}
>
    <header class="profile-heading" id={profile.slug}>
        {heroPhoto && (
            <img
                class="profile-hero-photo"
                src={contentUrl(heroPhoto.file)}
                alt=""
                width="1600"
                height="1067"
                fetchpriority="high"
            />
        )}
        <div class="profile-hero-shade" aria-hidden="true"></div>
        <div class="profile-hero-topline">
            <p>
                <SiteIcon name={collectionIcon} size={28} />
                {profile.eyebrow}
            </p>
            <span class="profile-number">
                <SiteIcon name="field-guide" size={22} />
                Plant {String(index + 1).padStart(2, "0")} / {profiles.length}
            </span>
        </div>
        <div class="profile-hero-title">
            {!ownedAvatar && (
                <img
                    class="profile-art"
                    src={siteUrl(`assets/plant-icons/${profile.slug}.svg`)}
                    alt=""
                    width="176"
                    height="176"
                />
            )}
            <div class="profile-title-copy">
                <p class="scientific-name">
                    {ownedAvatar && (
                        <img
                            class="profile-art profile-art-complement"
                            src={siteUrl(`assets/plant-icons/${profile.slug}.svg`)}
                            alt=""
                            width="48"
                            height="48"
                        />
                    )}
                    <span>{stripMarkdown(profile.scientificMarkdown)}</span>
                </p>
                <h1>{profile.title}</h1>
                <div class="profile-badges">
                    <span class="badge badge-record">
                        <SiteIcon name="inventory" size={24} />
                        <span>
                            <small>Collection Record</small>
                            <strong class="profile-badge-value">{profile.inventoryId}</strong>
                        </span>
                    </span>
                    <span class="badge badge-label">
                        <SiteIcon name="label" size={24} />
                        <span>
                            <small>Pot Label</small>
                            <strong class="profile-badge-value">
                                {profile.drawerLabel.primary}
                            </strong>
                        </span>
                    </span>
                    {profile.trackerId && (
                        <a class="badge badge-id" href={potUrl(profile.trackerId)}>
                            <SiteIcon name="tracker" size={24} />
                            <span>
                                <small>Pot History</small>
                                <strong class="profile-badge-value">{profile.trackerId}</strong>
                            </span>
                            <SiteIcon name="arrow-right" size={18} />
                        </a>
                    )}
                    {profile.historical && (
                        <span class="badge">
                            <SiteIcon name="history" />
                            Historical Record
                        </span>
                    )}
                    {profile.receiptUnverified && (
                        <span class="badge">
                            <SiteIcon name="seller" />
                            Ordered · Receipt Unverified
                        </span>
                    )}
                </div>
            </div>
            {ownedAvatar && (
                <figure class="profile-owned-avatar">
                    <a
                        class="profile-avatar-link"
                        href={ownedAvatar.page_url}
                        aria-label={`Open owned-plant photo of ${profile.title}`}
                    >
                        <img
                            class="profile-avatar-fallback"
                            src={siteUrl(`assets/plant-icons/${profile.slug}.svg`)}
                            alt=""
                            width="240"
                            height="240"
                            aria-hidden="true"
                        />
                        <img
                            class="profile-avatar-photo"
                            src={photoPreview(ownedAvatar)}
                            alt={ownedAvatar.alt}
                            width="240"
                            height="240"
                            data-image-id={ownedAvatar.image_id}
                        />
                    </a>
                    <figcaption>
                        <span data-avatar-caption>Owned plant · © Nick</span>
                    </figcaption>
                </figure>
            )}
        </div>
        {heroPhoto && (
            <p class="profile-hero-credit">
                Species reference · {heroPhoto.author} ·{" "}
                <a href={heroPhoto.license_url}>{heroPhoto.license}</a> ·{" "}
                <a href={heroPhoto.source_url}>Photo Source ↗</a>
            </p>
        )}
    </header>
    <dl class="metadata-grid">
        {metadata.map(([label, value, icon]) => (
            <div class={`profile-metadata profile-metadata-${icon}`}>
                <dt>
                    <img
                        src={siteUrl(`assets/ui-icons/${icon}.svg`)}
                        alt=""
                        width="32"
                        height="32"
                    />
                    <span>{label}</span>
                </dt>
                <dd set:html={value} />
            </div>
        ))}
        {profile.trackerId && profile.sheetUrl && (
            <div class="profile-metadata profile-metadata-status">
                <dt>
                    <img
                        src={siteUrl("assets/ui-icons/sheets.svg")}
                        alt=""
                        width="32"
                        height="32"
                    />
                    <span>Google Sheets ID</span>
                </dt>
                <dd>
                    <a href={profile.sheetUrl}>{profile.trackerId} ↗</a>
                </dd>
            </div>
        )}
        <div class="profile-metadata profile-metadata-photos">
            <dt>
                <img src={siteUrl("assets/ui-icons/photos.svg")} alt="" width="32" height="32" />
                <span>Photo History</span>
            </dt>
            <dd>
                <a href={`#${profile.slug}-photo-history`}>
                    {collectionCaptures.length}{" "}
                    {collectionCaptures.length === 1 ? "capture" : "captures"}
                    {newestCapture && (
                        <>
                            {" "}
                            · newest{" "}
                            <time datetime={newestCapture.captured_on ?? newestCapture.provided_on}>
                                {photoDate(newestCapture.captured_on ?? newestCapture.provided_on)}
                            </time>
                        </>
                    )}{" "}
                    ↓
                </a>
            </dd>
        </div>
        {profile.scopeNote && (
            <div class="profile-metadata profile-metadata-scope">
                <dt>
                    <img
                        src={siteUrl("assets/ui-icons/botanical.svg")}
                        alt=""
                        width="32"
                        height="32"
                    />
                    <span>Photo Scope</span>
                </dt>
                <dd>{profile.scopeNote}</dd>
            </div>
        )}
    </dl>
    {profile.trackerId && (
        <div class="card record-actions">
            <div>
                <h2>
                    <SiteIcon name="history" size={32} />
                    Measurements and Care History
                </h2>
                <p>Weights, watering, events, and charts for {profile.trackerId}.</p>
                {siblings.length > 0 && (
                    <p>
                        This container is shared with{" "}
                        {siblings.map((item, siblingIndex) => (
                            <>
                                <a href={profileUrl(item.slug)}>{item.title}</a>
                                {siblingIndex < siblings.length - 1 ? ", " : "."}
                            </>
                        ))}
                    </p>
                )}
            </div>
            <a class="button" href={potUrl(profile.trackerId)}>
                <SiteIcon name="tracker" />
                Open Pot History
                <SiteIcon name="arrow-right" size={18} />
            </a>
            {profile.sheetUrl && (
                <a class="button-secondary" href={profile.sheetUrl}>
                    <SiteIcon name="sheets" />
                    Google Sheets
                </a>
            )}
        </div>
    )}
    <section class="card-grid profile-introduction" aria-label="About this plant">
        <div class="card profile-story-card profile-story-appearance">
            <p class="eyebrow">
                <SiteIcon name="eye" size={28} />
                Spot it
            </p>
            <h2>What it looks like</h2>
            <p set:html={profile.visualDescriptionHtml} />
        </div>
        <div class="card profile-story-card profile-story-fact">
            <p class="eyebrow">
                <SiteIcon name="sparkles" size={28} />
                One curious thing
            </p>
            <h2>Did you know?</h2>
            <p set:html={profile.interestingFactHtml} />
        </div>
    </section>
    <div class="profile-reading">
        <details class="profile-toc" open>
            <summary>
                <SiteIcon name="field-guide" size={26} />
                Explore This Plant
            </summary>
            <nav aria-label="On this page">
                <ul>
                    {profile.toc
                        .filter((item) => item.level === 2)
                        .map((item) => (
                            <li>
                                <a href={`#${item.id}`}>
                                    <SiteIcon name={sectionIcon(item.title)} size={22} />
                                    {item.title}
                                </a>
                            </li>
                        ))}
                    <li>
                        <a href={`#${profile.slug}-photo-history`}>
                            <SiteIcon name="photos" />
                            Plant Photo History
                        </a>
                    </li>
                    {profile.nurseryPhotos.length > 0 && (
                        <li>
                            <a href={`#${profile.slug}-nursery-evidence`}>
                                <SiteIcon name="label" />
                                Nursery Evidence
                            </a>
                        </li>
                    )}
                    <li>
                        <a href={`#${profile.slug}-gallery-heading`}>
                            <SiteIcon name="botanical" />
                            Reference Gallery
                        </a>
                    </li>
                </ul>
            </nav>
        </details>
        <div class="prose profile-copy" set:html={profile.bodyHtml} />
    </div>
    <section class="photo-section" id={`${profile.slug}-photo-history`}>
        <div class="section-heading">
            <div>
                <p class="eyebrow">Dated collection evidence</p>
                <h2 id={`${profile.slug}-collection-heading`}>
                    <SiteIcon name="photos" size={36} />
                    Plant Photo History
                </h2>
            </div>
            {profile.collectionRecord.gyazo_collection && (
                <a class="button-secondary" href={profile.collectionRecord.gyazo_collection.url}>
                    Full Gyazo Collection ↗
                </a>
            )}
        </div>
        <p>
            The latest two owned-plant photographs. Open a capture or the full Collection for the
            complete history.
        </p>
        {profile.ownedPhotos.length ? (
            <div class="photo-grid">
                {profile.ownedPhotos.map((photo) => (
                    <figure class="card" data-photo-kind="collection">
                        <a href={photo.page_url}>
                            <img
                                src={photoPreview(photo)}
                                alt={photo.alt}
                                width="640"
                                height="480"
                                loading="lazy"
                                decoding="async"
                                data-image-id={photo.image_id}
                            />
                        </a>
                        <figcaption>
                            <strong>{photo.caption}</strong>
                            <span>
                                {photo.captured_on ? "Photographed" : "Provided"}{" "}
                                <time datetime={photo.captured_on ?? photo.provided_on}>
                                    {photoDate(photo.captured_on ?? photo.provided_on)}
                                </time>{" "}
                                · © Nick, all rights reserved
                            </span>
                            {photo.derived_note && <span>{photo.derived_note}</span>}
                            <a href={photo.page_url}>Open This Capture ↗</a>
                        </figcaption>
                    </figure>
                ))}
            </div>
        ) : (
            <p class="card">Collection photo pending. {profile.collectionRecord.pending_note}</p>
        )}
    </section>
    {profile.nurseryPhotos.length > 0 && (
        <section class="photo-section" id={`${profile.slug}-nursery-evidence`}>
            <p class="eyebrow">Original identification evidence</p>
            <h2 id={`${profile.slug}-nursery-heading`}>
                <SiteIcon name="label" size={36} />
                Nursery Labels
            </h2>
            <p>Seller wording is evidence, not botanical proof.</p>
            <div class="photo-grid">
                {profile.nurseryPhotos.map((photo) => (
                    <figure class="card" data-photo-kind="nursery-label">
                        <a href={photo.page_url}>
                            <img
                                src={photoPreview(photo)}
                                alt={photo.alt}
                                width="640"
                                height="480"
                                loading="lazy"
                                decoding="async"
                                data-image-id={photo.image_id}
                            />
                        </a>
                        <figcaption>
                            <strong>{photo.caption}</strong>
                            <span>
                                {photoDate(photo.captured_on ?? photo.provided_on)} · © Nick, all
                                rights reserved
                            </span>
                            <a href={photo.page_url}>Open Nursery Evidence ↗</a>
                            {photo.source_file && (
                                <a href={contentUrl(photo.source_file)}>Archived Evidence Crop</a>
                            )}
                        </figcaption>
                    </figure>
                ))}
            </div>
        </section>
    )}
    <section class="photo-section" aria-labelledby={`${profile.slug}-gallery-heading`}>
        <p class="eyebrow">Licensed species references</p>
        <h2 id={`${profile.slug}-gallery-heading`}>
            <SiteIcon name="botanical" size={36} />
            Reference Gallery
        </h2>
        <p>{profile.scopeNote}</p>
        <p>
            These photographs illustrate the working species or cultivar. They are separate from
            photographs of the owned plant, and do not establish its identification.
        </p>
        <div class="photo-grid reference-grid">
            {profile.allPhotos.map((photo) => (
                <figure class="card" data-photo-kind="reference">
                    <a href={photo.source_url}>
                        <img
                            src={contentUrl(photo.file)}
                            alt={photo.title}
                            width="640"
                            height="480"
                            loading="lazy"
                            decoding="async"
                        />
                    </a>
                    <figcaption>
                        <span class="eyebrow">{photo.subject.replaceAll("-", " ")}</span>
                        <strong>{photo.title}</strong>
                        <span>
                            {[photo.location, photo.observed_on].filter(Boolean).join(" · ")}
                        </span>
                        <span>
                            {photo.author} · <a href={photo.license_url}>{photo.license}</a>
                        </span>
                        <a href={photo.source_url}>Photo Source and Attribution ↗</a>
                    </figcaption>
                </figure>
            ))}
        </div>
        {!profile.allPhotos.length && <p>No licensed reference photographs are archived yet.</p>}
    </section>
    <section class="card research-links">
        <h2>
            <SiteIcon name="research" size={36} />
            Research Trail
        </h2>
        <ul>
            <li>
                <a href={`${repositoryUrl}/blob/main/${profile.sourcePath}`}>
                    <SiteIcon name="field-guide" size={28} />
                    Maintained Source Profile
                </a>
            </li>
            {profile.allPhotos.length > 0 && (
                <li>
                    <a href={`${repositoryUrl}/blob/main/assets/plants/${profile.slug}/README.md`}>
                        <SiteIcon name="photos" size={28} />
                        Complete Photo Archive and Credits
                    </a>
                </li>
            )}
            {profile.sellerProductLink && (
                <li>
                    <a href={profile.sellerProductLink.href}>
                        <SiteIcon name="seller" size={28} />
                        {profile.sellerProductLink.label}
                    </a>
                </li>
            )}
            {profile.inaturalist && (
                <li>
                    <a
                        href={`https://www.inaturalist.org/observations?taxon_name=${encodeURIComponent(profile.inaturalist.taxon)}`}
                    >
                        <SiteIcon name="habitat" size={28} />
                        iNaturalist Observations
                    </a>{" "}
                    — {profile.inaturalist.scope}
                </li>
            )}
        </ul>
    </section>
    <nav class="profile-neighbors" aria-label="Other plant profiles">
        {previous ? (
            <a
                class="profile-neighbor profile-neighbor-previous"
                href={profileUrl(previous.slug)}
                rel="prev"
            >
                <span>← Previous</span>
                <strong class="profile-neighbor-title">{previous.title}</strong>
            </a>
        ) : (
            <span></span>
        )}
        <a class="profile-neighbor profile-neighbor-index" href={siteUrl("plants/")}>
            All Plants
        </a>
        {next ? (
            <a
                class="profile-neighbor profile-neighbor-next"
                href={profileUrl(next.slug)}
                rel="next"
            >
                <span>Next →</span>
                <strong class="profile-neighbor-title">{next.title}</strong>
            </a>
        ) : (
            <span></span>
        )}
    </nav>
    <ProfileNavigation profiles={profiles} currentSlug={profile.slug} />
</article>
<script>
    import { initializeProfilePhotos } from "../client/profile";
    initializeProfilePhotos();
</script>
