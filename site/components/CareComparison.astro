---
import { getProfiles } from "../lib/content.mjs";
import {
    assertCareCoverage,
    getPlantCareReferences,
    LIGHT_COMPARISON_HOURS,
    lightComparison,
} from "../lib/plant-care.mjs";
import { profileUrl, siteUrl } from "../lib/routes.mjs";
import SiteIcon from "./SiteIcon.astro";
import "../styles/care-comparison.css";

const [profiles, records] = await Promise.all([getProfiles(), getPlantCareReferences()]);
assertCareCoverage(records, profiles);
const bySlug = new Map(records.map((record) => [record.slug, record]));
const active = profiles.filter((profile) => !profile.historical);
const number = new Intl.NumberFormat("en-US");
const range = (values: readonly [number, number] | null) =>
    values ? `${number.format(values[0])}–${number.format(values[1])}` : "Not assigned";
---

<section class="care-comparison" aria-labelledby="collection-care-comparison" data-care-comparison>
    <h2 id="collection-care-comparison">Compare the collection</h2>
    <p>
        {active.length} active profiles · {LIGHT_COMPARISON_HOURS} constant-light hours for
        comparison · trial ranges, not established minimums, optima, or maximums. Each link opens
        the plant's full care card.
    </p>
    <p>
        Lux is an approximate white-LED envelope, not a fixture calibration. Shared P-IDs have one
        watering decision. Read the measurement assumptions and exceptions below before changing
        care.
    </p>
    <details class="care-comparison-browser" data-print-care>
        <summary>Browse all {active.length} active plant references</summary>
        <ul class="care-comparison-list">
            {active.map((profile) => {
                const care = bySlug.get(profile.slug);
                if (!care) throw new Error(`Missing care comparison: ${profile.slug}`);
                const light = lightComparison(care.light);
                const careUrl = `${profileUrl(profile.slug)}#${profile.slug}-care-reference`;
                return (
                    <li class="care-comparison-row" data-care-row={profile.slug}>
                        <div class="care-comparison-identity">
                            <img
                                class="care-comparison-portrait"
                                src={siteUrl(`assets/plant-icons/${profile.slug}.svg`)}
                                width="72"
                                height="72"
                                loading="lazy"
                                decoding="async"
                                alt=""
                            />
                            <div class="care-comparison-title">
                                <p class="care-comparison-identifiers">
                                    <span>{profile.trackerId}</span>
                                    <span>{profile.inventoryId}</span>
                                </p>
                                <h3>
                                    <a href={careUrl}>{profile.title}</a>
                                </h3>
                            </div>
                        </div>
                        <p class="care-comparison-basis">
                            <SiteIcon name="info" size={18} />
                            {care.light.basis === "collection-trial"
                                ? "Provisional trial · not a limit"
                                : "Qualitative reference"}
                        </p>
                        <dl class="care-comparison-values">
                            <div>
                                <dt>
                                    <SiteIcon name="light" size={20} />
                                    PPFD
                                </dt>
                                <dd>
                                    <span class="care-comparison-range">{range(light.ppfd)}</span>
                                    <small>µmol·m⁻²·s⁻¹</small>
                                </dd>
                            </div>
                            <div>
                                <dt>
                                    <SiteIcon name="light" size={20} />
                                    Approx. lux
                                </dt>
                                <dd>
                                    <span class="care-comparison-range">{range(light.lux)}</span>
                                    <small>white-LED estimate</small>
                                </dd>
                            </div>
                            <div>
                                <dt>
                                    <SiteIcon name="clock" size={20} />
                                    Trial DLI
                                </dt>
                                <dd>
                                    <span class="care-comparison-range">
                                        {range(care.light.dli)}
                                    </span>
                                    <small>mol·m⁻²·day⁻¹</small>
                                </dd>
                            </div>
                        </dl>
                        <div class="care-comparison-footer">
                            <p class="care-comparison-moisture">
                                <SiteIcon name="moisture" size={22} />
                                <span>
                                    <strong>Drying stage</strong>
                                    {care.moisture.regime}
                                </span>
                            </p>
                            <a class="care-comparison-source-link" href={careUrl}>
                                Care &amp; sources
                                <SiteIcon name="arrow-right" size={20} />
                            </a>
                        </div>
                    </li>
                );
            })}
        </ul>
    </details>
</section>
<script src="../client/care-print.js"></script>
