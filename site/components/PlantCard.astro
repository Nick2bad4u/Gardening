---
import { profileUrl, siteUrl } from "../lib/routes.mjs";
import { identificationLabel, stripMarkdown } from "../lib/content/profile-source.mjs";
interface Props {
    profile: import("../lib/content.mjs").SiteProfile;
    sharedProfileCount?: number;
}
const { profile, sharedProfileCount = 1 } = Astro.props;
const photoCount = profile.collectionRecord.photos.filter(
    (photo) => photo.kind === "collection"
).length;
const identification = identificationLabel(profile.identificationMarkdown);
---

<article class="plant-card" data-plant-card>
    <a class="card plant-card-link" href={profileUrl(profile.slug)}>
        <div class="plant-card-summary">
            <img
                class="plant-card-art"
                src={siteUrl(`assets/plant-icons/${profile.slug}.svg`)}
                alt=""
                width="80"
                height="80"
                loading="lazy"
            />
            <div>
                <p class="eyebrow">{profile.groupTitle}</p>
                <h2>{profile.title}</h2>
                <p class="scientific">{stripMarkdown(profile.scientificMarkdown)}</p>
            </div>
        </div>
        <div class="plant-card-labels">
            <span class="badge badge-label">{profile.drawerLabel.primary}</span>
            {profile.trackerId && <span class="badge badge-id">{profile.trackerId}</span>}
            {profile.historical && <span class="badge">Historical</span>}
        </div>
        <div class="plant-card-metadata">
            <span class="badge" title="Identification evidence">
                {identification}
            </span>
            <span class="badge" title="Published photos of this collection plant">
                {photoCount} collection {photoCount === 1 ? "photo" : "photos"}
            </span>
            {sharedProfileCount > 1 && (
                <span class="badge">Shared pot · {sharedProfileCount} profiles</span>
            )}
        </div>
    </a>
</article>
<style>
    .plant-card {
        min-inline-size: 0;
        block-size: 100%;
    }
    .plant-card-link {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        block-size: 100%;
        padding: 1rem;
        color: inherit;
        text-decoration: none;
        &:hover,
        &:focus-visible {
            color: var(--ink);
            background: var(--surface-soft);
            border-color: var(--accent);
            box-shadow: 0 4px 16px color-mix(in srgb, var(--accent) 15%, transparent);
        }
    }
    .plant-card-summary {
        display: grid;
        grid-template-columns: [art-start] 64px [art-end title-start] minmax(0, 1fr) [title-end];
        gap: 0.75rem;
        align-items: center;
    }
    .plant-card-art {
        inline-size: 64px;
        block-size: 64px;
    }
    .plant-card h2 {
        margin: 0.2rem 0;
        font-size: 1.25rem;
    }
    .plant-card-metadata {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        & .badge {
            padding: 0.2rem 0.5rem;
            font-size: 0.75rem;
            font-weight: 500;
            line-height: 1.5;
            color: var(--muted);
            background: var(--surface-soft);
        }
    }
    .plant-card-labels {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-block-start: auto;
        & .badge {
            justify-content: center;
            min-inline-size: 3rem;
            min-block-size: 28px;
        }
    }
    .scientific {
        margin: 0;
        font-family: Georgia, serif;
        font-size: 0.875rem;
        font-style: italic;
        color: var(--muted);
    }
</style>
