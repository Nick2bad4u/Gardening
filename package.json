{
    "name": "gardening",
    "private": true,
    "scripts": {
        "apps-script:deployments": "clasp deployments",
        "apps-script:login": "clasp login",
        "apps-script:logs": "clasp logs",
        "apps-script:open": "clasp open-script",
        "apps-script:pull": "clasp pull",
        "apps-script:push": "clasp push",
        "apps-script:status": "clasp status",
        "build:booklet": "node scripts/build-plant-booklet.mjs",
        "build:pages": "npm run build:booklet && node scripts/build-pages-site.mjs",
        "build:print-book": "node scripts/build-print-book.mjs",
        "build:print-cover": "node scripts/build-print-cover.mjs",
        "changelog:generate": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/Gardening --output CHANGELOG.md",
        "changelog:preview": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/Gardening --unreleased",
        "changelog:release-notes": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/Gardening --current",
        "check:booklet": "node scripts/build-plant-booklet.mjs --check && node scripts/check-plant-booklet.mjs",
        "check:logger": "node scripts/check-google-sheets-logger.mjs",
        "check:print-book": "node scripts/check-print-book.mjs",
        "lint:gitleaks": "gitleaks dir --config .gitleaks.toml .",
        "lint:html": "htmlhint --config node_modules/htmlhint-config-nick2bad4u/recommended.json --ignore \".print-output/**,coverage/**,.pages-site/**,node_modules/**\" \"**/*.html\"",
        "lint:lychee": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml --host-concurrency 2 --host-request-interval 250ms --timeout 60 --exclude \"^https?://(?:www\\.)?inaturalist\\.org/observations(?:[/?#].*)?$\" --exclude \"^https?://(?:www\\.)?svgrepo\\.com/\" --exclude \"^https?://www\\.homedepot\\.com/p/SMART-PLANET-5-in-Succulent-Garden-in-Deep-Dish-Terra-Cotta-Clay-Planter-0872523/320207970$\" --exclude-path \"publish-collection-photo\\.ps1$\" --exclude-path \"publish-collection-photo\\.Tests\\.ps1$\" .",
        "lint:lychee:smoke": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml --dump-inputs README.md",
        "lint:remark": "npx remark . --frail --ignore-path .remarkignore",
        "lint:remark:fix": "npx remark . --ignore-path .remarkignore --output",
        "render:print-book": "node scripts/render-print-book.mjs && node scripts/build-print-cover.mjs && node scripts/render-print-cover.mjs",
        "render:print-cover": "node scripts/build-print-cover.mjs && node scripts/render-print-cover.mjs",
        "review:print-book": "node scripts/review-print-book.mjs",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:logger": "vitest run test/google-sheets",
        "test:logger:coverage": "vitest run test/google-sheets --coverage",
        "test:logger:watch": "vitest test/google-sheets",
        "update-actions": "npx actions-up --yes --style sha --quiet",
        "update-all": "npm run update-actions && npm run update-deps",
        "update-deps": "ncu --interactive --interactiveSelect all --configFileName .ncurc.json --configFilePath node_modules/ncu-config-nick2bad4u && npm update --force && npm install --force"
    },
    "devDependencies": {
        "@google/clasp": "^3.4.0",
        "@types/google-apps-script": "^2.0.12",
        "@vitest/coverage-v8": "4.1.11",
        "git-cliff": "^2.13.1",
        "gitcliff-config-nick2bad4u": "^1.5.0",
        "gitleaks-config-nick2bad4u": "^1.0.5",
        "happy-dom": "^20.11.12",
        "htmlhint": "^1.9.2",
        "htmlhint-config-nick2bad4u": "^1.0.0",
        "lychee-config-nick2bad4u": "^3.0.1",
        "ncu-config-nick2bad4u": "^0.2.1",
        "npm-check-updates": "^23.1.0",
        "pdf-lib": "^1.17.1",
        "playwright-core": "^1.62.1",
        "prettier": "^3.9.6",
        "prettier-config-nick2bad4u": "^2.0.4",
        "qrcode": "^1.5.4",
        "remark": "^15.0.1",
        "remark-cli": "^12.0.1",
        "remark-config-nick2bad4u": "^1.1.4",
        "remark-gfm": "^4.0.1",
        "remark-html": "^16.0.1",
        "remark-lint-write-good": "^1.2.0",
        "secretlint": "^13.0.5",
        "secretlint-config-nick2bad4u": "^1.1.2",
        "sharp": "^0.35.4",
        "vitest": "^4.1.11"
    },
    "allowScripts": {
        "fsevents@2.3.3": true,
        "core-js": false
    }
}
