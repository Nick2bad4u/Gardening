{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "erasableSyntaxOnly": true,
        "noPropertyAccessFromIndexSignature": true,
        "noUncheckedSideEffectImports": true,
        "types": [
            "node",
            "astro/client"
        ],
        "useUnknownInCatchVariables": true,
        "verbatimModuleSyntax": true
    },
    "exclude": [
        ".pages-site",
        ".cache",
        "node_modules"
    ],
    "extends": "astro/tsconfigs/strictest",
    "include": [
        ".astro/types.d.ts",
        "site/**/*",
        "astro.config.ts",
        "types/**/*.d.ts"
    ]
}
